{
  "version": "0.2.0",
  "configurations": [
    {
      // First, so that a plain F5 starts the API, the dev server and the telemetry dashboard
      // together. The WebAPI-only configurations below leave nothing listening on the OTLP
      // endpoint, which switches the SPA's browser telemetry off for that session.
      "name": "Launch Aspire AppHost",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/PrepperBox.AppHost/bin/Debug/net10.0/Genius.PrepperBox.AppHost.exe",
      "args": [],
      "cwd": "${workspaceFolder}/PrepperBox.AppHost",
      "launchSettingsFilePath": "${workspaceFolder}/PrepperBox.AppHost/Properties/launchSettings.json",
      "launchSettingsProfile": "http",
      // Merged over the launch profile's variables. Without it the dashboard demands the login token
      // printed in the debug console, and the page opened below lands on the login screen. Set here
      // rather than in launchSettings.json so `dotnet run` and other IDEs keep the token.
      "env": {
        "ASPIRE_DASHBOARD_UNSECURED_ALLOW_ANONYMOUS": "true"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+http://localhost:15191\\b",
        "uriFormat": "http://localhost:15191/"
      },
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Launch WebAPI (no build)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/PrepperBox.WebApi/bin/Debug/net10.0/PrepperBox.WebApi.exe",
      "args": [],
      "cwd": "${workspaceFolder}/PrepperBox.WebApi",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Launch WebAPI",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/PrepperBox.WebApi/bin/Debug/net10.0/PrepperBox.WebApi.exe",
      "args": [],
      "cwd": "${workspaceFolder}/PrepperBox.WebApi",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": ".NET Core Attach",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
