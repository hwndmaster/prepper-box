{
  "version": "0.2.0",
  "configurations": [
    {
      // The Vite dev server on 5096, talking to the API on 5095 (VITE_API_URL in the web project's .env).
      "name": "Launch Web",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm start",
      "cwd": "${workspaceFolder}/PrepperBox.Web"
    },
    {
      "name": "Launch WebAPI (no build)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/PrepperBox.WebApi/bin/Debug/net10.0/PrepperBox.WebApi.exe",
      "args": [],
      "cwd": "${workspaceFolder}/PrepperBox.WebApi",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Launch WebAPI",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/PrepperBox.WebApi/bin/Debug/net10.0/PrepperBox.WebApi.exe",
      "args": [],
      "cwd": "${workspaceFolder}/PrepperBox.WebApi",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": ".NET Core Attach",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ],
  "compounds": [
    {
      // The API and the dev server together. Pick it once in the Run and Debug dropdown and F5 keeps
      // starting both; stopping one stops the other.
      "name": "API + Web",
      "configurations": ["Launch WebAPI", "Launch Web"],
      "stopAll": true
    }
  ]
}
