# Copy to .env next to app.json and fill in. Server-specific, so never committed (the root .gitignore's
# ".env" rule covers it).
#
# Read twice: by the app host, for the ${NAME} values in app.json, and by update.ps1, to pull the same
# image tag the app host will run.

# ── Required ──────────────────────────────────────────────────────────────────────────────────────
# Paths on the server for the SQLite database and the API's log files, by default inside this folder
# (C:\Docker\prepper-box). The server's Docker daemon resolves them, so on Docker Desktop for Windows use
# a forward-slash Windows path; on Linux an absolute path.
PREPPER_BOX_DATA_PATH=C:/Docker/prepper-box/Data
PREPPER_BOX_LOGS_PATH=C:/Docker/prepper-box/Logs

# Path on the server holding server.crt and server.key. nginx in the web image declares the HTTPS server
# unconditionally and will not start without them (see "HTTPS setup" in the repo-root readme.md).
PREPPER_BOX_CERTS_PATH=C:/Docker/prepper-box/certs

# ── Optional ──────────────────────────────────────────────────────────────────────────────────────
# Image coordinates. update.ps1 pulls with this server's own registry login:
#   echo <token with read:packages> | docker login ghcr.io -u hwndmaster --password-stdin
#PREPPER_BOX_REGISTRY=ghcr.io/hwndmaster
#PREPPER_BOX_IMAGE_TAG=latest

# SerpApi key for the product image search (Google Images). A free account covers 250 searches a month:
# https://serpapi.com/manage-api-key. Leave unset to keep the image search disabled.
#PREPPER_BOX_SERPAPI_KEY=

# Telegram bot for the expiration notifications: the token from @BotFather and the chat the bot posts
# to. Both are needed; leave either unset to keep the notifications disabled.
#PREPPER_BOX_TELEGRAM_BOT_TOKEN=
#PREPPER_BOX_TELEGRAM_CHAT_ID=

# Host ports for the API and the SPA (HTTP and HTTPS).
#PREPPER_BOX_API_PORT=5095
#PREPPER_BOX_WEB_PORT=5096
#PREPPER_BOX_WEB_HTTPS_PORT=5097

# Memory limits, in docker's notation (384m, 1g). Raise one if its container keeps restarting and
# `docker inspect` reports it OOMKilled. A change applies on the next .\update.ps1 -SkipPull.
#PREPPER_BOX_API_MEMORY_LIMIT=384m
#PREPPER_BOX_WEB_MEMORY_LIMIT=64m
