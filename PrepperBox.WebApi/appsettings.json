{
  // This section filters the Microsoft.Extensions.Logging pipeline, which is what feeds the
  // OpenTelemetry exporter and therefore the Aspire dashboard. It has to mirror the Serilog overrides
  // below: with only "Default": "Information" here, every EF Core SQL command is exported to the
  // dashboard on every request.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      // Was a flat "Verbose", which sent every framework trace to disk. Atom's request-summary
      // middleware gives the same visibility in one line per request without the volume.
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        // Exempted from the blanket Microsoft override: the "Now listening on" / "Application started"
        // markers that bracket every restart in the log.
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": [ "FromLogContext", "WithThreadId" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/PrepperBox_.log",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level}] <{ThreadId}> {SourceContextName} - {Message:lj}{NewLine}{Exception}",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true,
          "restrictedToMinimumLevel": "Information",
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Database": {
    "Backup": {
      "Enabled": true,
      "MaxBackups": 5,
      "IntervalDays": 7
    }
  },
  "Cors": {
    "Origins": []
  },
  "Telegram": {
    "BotToken": "",
    "ChatId": ""
  },
  "ExpirationCheck": {
    "NotificationTime": "10:00:00",
    "NotificationWindowMinutes": 30,
    "GreenNotificationIntervalDays": 5
  }
}
