{
  // Filters the Microsoft.Extensions.Logging pipeline, which is what feeds the OpenTelemetry exporter
  // and therefore the Aspire dashboard. Mirrors the Serilog overrides in appsettings.json; with only
  // "Default": "Information" here, every EF Core SQL command is exported to the dashboard.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Cors": {
    "Origins": [ "http://localhost:5096" ]
  }
}
